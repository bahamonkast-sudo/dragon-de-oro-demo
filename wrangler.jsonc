{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "binaryteach-demo",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./deploy",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "binaryteach-demo",
      "database_id": "b9a6ac9c-d05a-4254-8f43-ed745b841531",
      "migrations_dir": "migrations"
    }
  ]
}
